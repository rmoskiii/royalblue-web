+          </div>
+        }
+      />
+      <div className="grid gap-4">
+        <SummaryCards />
+        <div className="grid items-start gap-4 xl:grid-cols-[minmax(0,1fr)_320px]">
+          <Card className="min-w-0">
+            <CardHeader
+              title={
+                <span className="flex items-center gap-3">
