+
+const frequencyLabel: Record<ContributionFrequency, string> = {
+  daily: 'daily',
+  weekly: 'weekly',
+  monthly: 'monthly',
+};
+
+export function VaultCard({ vault: v }: { vault: SavingsVault }) {
+  const { showToast } = useToast();
+  const progress = v.target ? v.balance / v.target : null;
