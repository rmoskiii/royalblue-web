# Same-origin `/api` (Vite proxy → localhost:3000, Vercel rewrite → Render).
# Do not point the browser at the Render host: httpOnly cookies would be third-party.
VITE_API_BASE_URL=/api/v1

# true = in-memory mocks in src/api/mocks
# false = live Nest on pair-program (login, PIN, banks, bills, loans, staff desk)
VITE_USE_MOCKS=false
